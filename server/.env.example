# =====================================================================
# .env.example - תבנית למשתני סביבה
#
# העתיקי את הקובץ הזה ל-.env ומלאי את הערכים האמיתיים.
# הקובץ .env לעולם לא יעלה ל-GitHub (הוא ב-.gitignore).
# =====================================================================

# פורט שהשרת יאזין עליו
PORT=3001

# סביבה - development או production
NODE_ENV=development

# =====================================================================
# הגדרות API של אוריין
# =====================================================================

# כתובת הבסיס של אוריין
# סביבת בדיקות: https://disapiTest.orian.com
# סביבת ייצור:  https://disapi.orian.com
ORIAN_BASE_URL=https://disapiTest.orian.com

# שם המשתמש והסיסמה לאוריין
ORIAN_USERNAME=
ORIAN_PASSWORD=

# מספר הלקוח (Consignee Number) של מייה אינספיריישן אצל אוריין
ORIAN_CONSIGNEE=

# =====================================================================
# אבטחה
# =====================================================================

# מפתח חתימה לטוקנים (JWT) - אקראי וחזק
# ניתן ליצור עם: openssl rand -base64 32
JWT_SECRET=

# =====================================================================
# מסד נתונים
# =====================================================================

# נתיב לקובץ ה-SQLite
DATABASE_PATH=./data/mia.db
